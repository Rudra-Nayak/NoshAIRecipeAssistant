# Environment variables for Nosh Recipe Chatbot
# Copy this file to .env and fill in your API key

# Google Gemini API key (required for LLM features)
GEMINI_API_KEY=your_api_key_here

# Optional: Embedding model name (default: models/text-embedding-004)
# EMBEDDING_MODEL=models/text-embedding-004

# Optional: Gemini generation model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

